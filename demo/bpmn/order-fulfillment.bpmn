<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_order-fulfillment" targetNamespace="http://camunda.org/examples">
  <bpmn:message id="Msg_Packed" name="OrderPacked" />
  <bpmn:process id="order-fulfillment" name="Order fulfillment" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="Start" name="Order received" />
    <bpmn:serviceTask id="Validate" name="Validate order" camunda:expression="${true}" />
    <bpmn:exclusiveGateway id="Method" name="Payment method?" />
    <bpmn:serviceTask id="Charge" name="Charge card" camunda:type="external" camunda:topic="charge-card" />
    <bpmn:userTask id="Approve" name="Approve invoice" />
    <bpmn:exclusiveGateway id="Join" name="" />
    <bpmn:receiveTask id="Warehouse" name="Wait for warehouse" messageRef="Msg_Packed" />
    <bpmn:serviceTask id="Ship" name="Ship order" camunda:expression="${shipping.dispatch(execution)}" camunda:asyncBefore="true" />
    <bpmn:endEvent id="End" name="Order shipped" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start" targetRef="Validate"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Validate" targetRef="Method"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Method" targetRef="Charge"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${method == 'card'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Method" targetRef="Approve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${method != 'card'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Charge" targetRef="Join"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Approve" targetRef="Join"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Join" targetRef="Warehouse"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Warehouse" targetRef="Ship"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Ship" targetRef="End"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_order-fulfillment">
    <bpmndi:BPMNPlane id="Plane_order-fulfillment" bpmnElement="order-fulfillment">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="100" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Validate_di" bpmnElement="Validate"><dc:Bounds x="180" y="100" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Method_di" bpmnElement="Method"><dc:Bounds x="340" y="115" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Charge_di" bpmnElement="Charge"><dc:Bounds x="440" y="100" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Approve_di" bpmnElement="Approve"><dc:Bounds x="440" y="240" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_di" bpmnElement="Join"><dc:Bounds x="600" y="115" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Warehouse_di" bpmnElement="Warehouse"><dc:Bounds x="700" y="100" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ship_di" bpmnElement="Ship"><dc:Bounds x="860" y="100" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1020" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="136" y="140" /><di:waypoint x="180" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="290" y="140" /><di:waypoint x="340" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="390" y="140" /><di:waypoint x="440" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="365" y="165" /><di:waypoint x="365" y="280" /><di:waypoint x="440" y="280" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="550" y="140" /><di:waypoint x="600" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="550" y="280" /><di:waypoint x="625" y="280" /><di:waypoint x="625" y="165" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="650" y="140" /><di:waypoint x="700" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="810" y="140" /><di:waypoint x="860" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="970" y="140" /><di:waypoint x="1020" y="140" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
