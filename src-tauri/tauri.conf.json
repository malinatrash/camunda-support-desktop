{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Camunda Support",
  "version": "2.0.1",
  "identifier": "com.malinatrash.camundasupport",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Поддержка Camunda",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi",
      "nsis",
      "deb"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Консоль поддержки Camunda 7",
    "longDescription": "Desktop-приложение для расследования и восстановления процессов Camunda 7.",
    "publisher": "malinatrash",
    "copyright": "malinatrash",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "ru-RU"
      }
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "camunda-support"
        ]
      }
    }
  }
}
